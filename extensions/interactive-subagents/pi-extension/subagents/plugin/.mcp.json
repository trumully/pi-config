{
  "mcpServers": {
    "pi": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/ask_question.py"
      ],
      "env": {
        "PI_CLAUDE_ASK_FILE": "${PI_CLAUDE_ASK_FILE}",
        "PI_CLAUDE_PENDING_FILE": "${PI_CLAUDE_PENDING_FILE}"
      }
    }
  }
}
