{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"${CLAUDE_PLUGIN_ROOT}/hooks/on-user-prompt.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/on-stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
