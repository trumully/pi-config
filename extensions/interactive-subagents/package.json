{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/test.ts",
    "test:surface": "node --test --test-concurrency=1 test/integration/herdr-surface.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/subagent-lifecycle.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "typebox": "^1.3.27"
  }
}
